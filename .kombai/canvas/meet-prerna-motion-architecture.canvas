      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400&family=Urbanist:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Libre+Baskerville:ital@0;1&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n:root{--ink:#111111;--ink100:#212121;--ink200:#2A2A2A;--ink300:#363636;--ink500:#6B6B6B;--ivory:#FDFFE9;--ivorydim:#C9CBB6;--lime:#C4FF61}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);font-family:Urbanist,sans-serif;color:var(--ivory)}.serif{font-family:'Cormorant Garamond',serif}.mono{font-family:'JetBrains Mono',monospace}.quote{font-family:'Libre Baskerville',serif}.focus-ring:focus-visible{outline:2px solid var(--lime);outline-offset:2px}.hero-copy{visibility:hidden}.load-line{stroke-dasharray:260;stroke-dashoffset:260}.marquee-track{animation:marquee 40s linear infinite}.marquee:hover .marquee-track{animation-play-state:paused}@keyframes marquee{to{transform:translateX(-50%)}}.stat-cell:hover{background:rgb(253 255 233 / .05);transform:translateY(-4px)}.cta:hover{background:var(--lime);color:var(--ink);box-shadow:0 0 24px rgb(196 255 97 / .18)}.nav-docked{background:var(--ink);border-color:#363636;left:50%;right:auto;transform:translateX(-50%);padding:10px 18px;width:max-content;border-radius:9999px}.nav-docked .brand-word{max-width:0;opacity:0;margin:0;overflow:hidden}.rail{scroll-snap-type:x proximity;scrollbar-width:none}.rail::-webkit-scrollbar{display:none}.work-piece{scroll-snap-align:start}.dragging{cursor:grabbing!important;user-select:none}@media(max-width:1023px){.two-anchor{display:block}.two-anchor>div+div{margin-top:2rem}.hero-title{font-size:6.5rem!important}.hero-copy{max-width:340px}.section-pad{padding-top:96px!important;padding-bottom:96px!important}.stats-grid{margin-top:3rem;width:100%!important}.quote-row{display:block}.quote-row blockquote{width:100%!important;margin-top:1.5rem}.contact-title{font-size:7rem!important}.nav-links{display:none}.work-piece{width:75vw!important}}@media(prefers-reduced-motion:reduce){.preloader{display:none!important}.marquee-track{animation:none}.hero-copy{visibility:visible}.stat-cell,.quote-row,.hinge-image{transform:none!important;opacity:1!important}.marquee-track{transform:none!important}}\n</style>\n<div aria-hidden=\"true\" class=\"preloader fixed inset-0 z-[100] flex items-center justify-center bg-[#111]\" data-dynamic=\"true\" data-kid=\"1\" data-name=\"page preloader overlay\" data-reason=\"element removed by script after animation\">\n    <svg class=\"h-28 w-28\" data-kid=\"1-1\" data-name=\"loading spinner svg\" fill=\"none\" viewbox=\"0 0 100 100\">\n        <path class=\"load-line\" d=\"M29 76V22h26c19 0 22 28 1 31H29m25 0 18 23\" stroke=\"#C4FF61\" stroke-width=\"2\">\n        </path>\n    </svg>\n</div>\n<header class=\"fixed top-0 z-50 flex w-full items-center justify-between border border-transparent px-8 py-7 text-[11px] text-[#FDFFE9] transition-all duration-300\" data-kid=\"2\" data-name=\"site header navigation\" id=\"nav\">\n    <a aria-label=\"MeetPrerna home\" class=\"focus-ring flex items-center gap-3 no-underline text-[#FDFFE9]\" data-kid=\"2-1\" data-name=\"brand link\" href=\"#top\">\n        <svg aria-hidden=\"true\" class=\"h-6 w-6 shrink-0\" data-kid=\"2-1-1\" data-name=\"brand logo icon\" fill=\"none\" viewbox=\"0 0 30 30\">\n            <path d=\"M7 24V6h9c7 0 8 9 0 10H7m9 0 6 8\" stroke=\"currentColor\" stroke-width=\"1.1\">\n            </path>\n        </svg>\n        <span class=\"brand-word mono max-w-32 overflow-hidden tracking-[.15em] transition-all duration-300\" data-kid=\"2-1-2\" data-name=\"brand name text\">\n            MEETPRERNA\n        </span>\n    </a>\n    <nav aria-label=\"Main navigation\" class=\"nav-links flex gap-7 mono text-[10px] tracking-[.12em]\" data-kid=\"2-2\" data-name=\"main navigation menu\">\n        <a class=\"focus-ring text-inherit no-underline\" data-kid=\"2-2-1\" data-name=\"work navigation link\" href=\"#work\">\n            WORK\n        </a>\n        <a class=\"focus-ring text-inherit no-underline\" data-kid=\"2-2-2\" data-name=\"voices navigation link\" href=\"#voices\">\n            VOICES\n        </a>\n        <a class=\"focus-ring text-inherit no-underline\" data-kid=\"2-2-3\" data-name=\"contact navigation link\" href=\"#contact\">\n            CONTACT\n        </a>\n    </nav>\n</header>\n<main data-kid=\"3\" data-name=\"main content area\" id=\"top\">\n    <section class=\"relative h-[100svh] min-h-[720px] overflow-hidden bg-[#111]\" data-kid=\"3-1\" data-name=\"hero section\">\n        <div class=\"absolute inset-0\" data-kid=\"3-1-1\" data-name=\"hero media container\" id=\"hero-media\">\n            <img alt=\"Woman in a shadowed architectural room, photo by Agnieszka Stankiewicz on Unsplash\" class=\"h-full w-full object-cover opacity-80\" data-kid=\"3-1-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"eager\" src=\"https://images.unsplash.com/photo-1728845864522-f503655fddcc?auto=format&w=1920&q=80&fit=crop\"/>\n            <div class=\"absolute inset-0 bg-black/35\" data-kid=\"3-1-1-2\" data-name=\"hero image overlay\">\n            </div>\n        </div>\n        <div class=\"absolute inset-0 bg-black/15\" data-kid=\"3-1-2\" data-name=\"hero background dimming layer\">\n        </div>\n        <div class=\"absolute left-8 top-28 z-10\" data-kid=\"3-1-3\" data-name=\"hero branding container\">\n            <svg aria-label=\"Abstract P mark\" class=\"h-24 w-24\" data-kid=\"3-1-3-1\" data-name=\"abstract P mark icon\" fill=\"none\" id=\"stencil\" viewbox=\"0 0 100 100\">\n                <path class=\"stencil-line\" d=\"M28 78V20h27c21 0 23 31 0 34H28m29-1 19 25\" stroke=\"#C4FF61\" stroke-width=\"1.5\">\n                </path>\n            </svg>\n        </div>\n        <div class=\"two-anchor absolute inset-x-8 bottom-10 z-10 flex items-end justify-between gap-10\" data-kid=\"3-1-4\" data-name=\"hero content container\">\n            <div class=\"hero-copy\" data-kid=\"3-1-4-1\" data-name=\"hero left content column\" id=\"hero-left\">\n                <p class=\"mono mb-3 text-[10px] tracking-[.18em] text-[#C9CBB6]\" data-kid=\"3-1-4-1-1\" data-name=\"hero category label\">\n                    ARTIST / SPATIAL IMAGE-MAKING\n                </p>\n                <h1 class=\"hero-title serif text-[clamp(7rem,13vw,12.5rem)] font-normal leading-[.65] tracking-[-.06em]\" data-kid=\"3-1-4-1-2\" data-name=\"hero headline text\">\n                    Prerna.\n                </h1>\n            </div>\n            <div class=\"hero-copy w-[330px] pb-1\" data-kid=\"3-1-4-2\" data-name=\"hero right content column\" id=\"hero-right\">\n                <p class=\"text-[19px] leading-[1.35]\" data-kid=\"3-1-4-2-1\" data-name=\"hero description text\">\n                    Making images for the spaces between a body, a building, and an idea.\n                </p>\n                <a class=\"cta focus-ring mono mt-7 inline-flex items-center gap-7 border border-[#C4FF61] px-5 py-3 text-[10px] tracking-[.08em] text-[#FDFFE9] no-underline\" data-kid=\"3-1-4-2-2\" data-name=\"call-to-action enter-work button\" href=\"#work\">\n                    ENTER THE WORK\n                    <i class=\"ti ti-arrow-up-right text-sm\" data-kid=\"3-1-4-2-2-1\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n        <noscript data-kid=\"3-1-5\" data-name=\"noscript styling block\">\n            <style>\n                .hero-copy{visibility:visible}\n            </style>\n        </noscript>\n    </section>\n    <section aria-label=\"Studio locations\" class=\"marquee overflow-hidden bg-[#212121] py-5\" data-kid=\"3-2\" data-name=\"studio locations marquee section\">\n        <div class=\"marquee-track flex w-max gap-12 whitespace-nowrap mono text-[11px] tracking-[.12em] text-[#C9CBB6]\" data-kid=\"3-2-1\" data-name=\"marquee track container\">\n            <span data-kid=\"3-2-1-1\" data-name=\"location 1 text\">\n                40.7128° N, 74.0060° W — NEW YORK\n            </span>\n            <span data-kid=\"3-2-1-2\" data-name=\"location 2 text\">\n                48.8566° N, 2.3522° E — PARIS\n            </span>\n            <span data-kid=\"3-2-1-3\" data-name=\"location 3 text\">\n                19.0760° N, 72.8777° E — MUMBAI\n            </span>\n            <span data-kid=\"3-2-1-4\" data-name=\"location 1 duplicate text\">\n                40.7128° N, 74.0060° W — NEW YORK\n            </span>\n            <span aria-hidden=\"true\" data-kid=\"3-2-1-5\" data-name=\"location 2 duplicate text\">\n                48.8566° N, 2.3522° E — PARIS\n            </span>\n            <span aria-hidden=\"true\" data-kid=\"3-2-1-6\" data-name=\"location 3 duplicate text\">\n                19.0760° N, 72.8777° E — MUMBAI\n            </span>\n        </div>\n    </section>\n    <section class=\"section-pad bg-[#111] px-8 py-48\" data-kid=\"3-3\" data-name=\"practice section\">\n        <div class=\"two-anchor mx-auto flex max-w-[1200px] justify-between gap-28\" data-kid=\"3-3-1\" data-name=\"practice content grid\">\n            <div data-kid=\"3-3-1-1\" data-name=\"practice section headline container\">\n                <p class=\"mono text-[10px] tracking-[.18em] text-[#6B6B6B]\" data-kid=\"3-3-1-1-1\" data-name=\"practice section label\">\n                    01 / PRACTICE\n                </p>\n                <h2 class=\"serif mt-5 text-7xl leading-[.85]\" data-kid=\"3-3-1-1-2\" data-name=\"practice section heading\">\n                    The\n                    <br data-kid=\"3-3-1-1-2-1\" data-name=\"line break\"/>\n                    scale.\n                </h2>\n            </div>\n            <div class=\"stats-grid grid w-[590px] grid-cols-2 border-l border-t border-[#363636]\" data-kid=\"3-3-1-2\" data-name=\"stats grid container\">\n                <div class=\"stat-cell min-h-52 border-b border-r border-[#363636] p-6\" data-kid=\"3-3-1-2-1\" data-name=\"exhibitions stat card\">\n                    <strong class=\"mono block text-4xl font-normal\" data-kid=\"3-3-1-2-1-1\" data-name=\"exhibitions count number\">\n                        14\n                    </strong>\n                    <span class=\"mt-14 block text-sm text-[#C9CBB6]\" data-kid=\"3-3-1-2-1-2\" data-name=\"exhibitions label text\">\n                        Exhibitions\n                    </span>\n                </div>\n                <div class=\"stat-cell min-h-52 border-b border-r border-[#363636] p-6\" data-kid=\"3-3-1-2-2\" data-name=\"views stat card\">\n                    <strong class=\"mono block text-4xl font-normal\" data-kid=\"3-3-1-2-2-1\" data-name=\"views count number\">\n                        2.4M\n                    </strong>\n                    <span class=\"mt-14 block text-sm text-[#C9CBB6]\" data-kid=\"3-3-1-2-2-2\" data-name=\"views label text\">\n                        Views, worldwide\n                    </span>\n                </div>\n                <div class=\"stat-cell min-h-52 border-b border-r border-[#363636] p-6\" data-kid=\"3-3-1-2-3\" data-name=\"awards stat card\">\n                    <strong class=\"mono block text-4xl font-normal\" data-kid=\"3-3-1-2-3-1\" data-name=\"awards count number\">\n                        08\n                    </strong>\n                    <span class=\"mt-14 block text-sm text-[#C9CBB6]\" data-kid=\"3-3-1-2-3-2\" data-name=\"awards label text\">\n                        Honours / awards\n                    </span>\n                </div>\n                <div class=\"stat-cell min-h-52 border-b border-r border-[#363636] p-6\" data-kid=\"3-3-1-2-4\" data-name=\"studio stat card\">\n                    <strong class=\"mono block text-4xl font-normal\" data-kid=\"3-3-1-2-4-1\" data-name=\"studio count number\">\n                        01\n                    </strong>\n                    <span class=\"mt-14 block text-sm text-[#C9CBB6]\" data-kid=\"3-3-1-2-4-2\" data-name=\"studio label text\">\n                        Nomadic studio\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"section-pad bg-[#111] pb-48 pt-0\" data-kid=\"3-4\" data-name=\"selected work section\" id=\"work\">\n        <div class=\"mx-auto mb-12 flex max-w-[1200px] items-end justify-between px-8\" data-kid=\"3-4-1\" data-name=\"work section header container\">\n            <div data-kid=\"3-4-1-1\" data-name=\"work section header left\">\n                <p class=\"mono text-[10px] tracking-[.18em] text-[#6B6B6B]\" data-kid=\"3-4-1-1-1\" data-name=\"work section label\">\n                    02 / SELECTED WORK\n                </p>\n                <h2 class=\"serif mt-4 text-7xl leading-none\" data-kid=\"3-4-1-1-2\" data-name=\"work section headline\">\n                    Selected work.\n                </h2>\n            </div>\n            <p class=\"mono text-[10px] tracking-[.14em] text-[#C9CBB6]\" data-kid=\"3-4-1-2\" data-name=\"drag instructions text\">\n                DRAG TO EXPLORE →\n            </p>\n        </div>\n        <div aria-label=\"Selected projects horizontal gallery\" class=\"rail flex cursor-grab gap-5 overflow-x-auto pl-[max(32px,calc((100vw-1200px)/2))] pr-8\" data-kid=\"3-4-2\" data-name=\"horizontal work gallery rail\" id=\"rail\">\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-1\" data-name=\"work piece card 1\">\n                <img alt=\"Concrete forms by uve sanchez on Unsplash\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-1-1\" data-name=\"work piece image 1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1565626424178-c699f6601afd?auto=format&w=900&q=80&fit=crop\"/>\n                <figcaption class=\"mono mt-3 flex justify-between text-[10px]\" data-kid=\"3-4-2-1-2\" data-name=\"work caption 1\">\n                    <span data-kid=\"3-4-2-1-2-1\" data-name=\"work title 1\">\n                        01 / MONOLITH\n                    </span>\n                    <span data-kid=\"3-4-2-1-2-2\" data-name=\"work year 1\">\n                        2025\n                    </span>\n                </figcaption>\n            </figure>\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-2\" data-name=\"work piece card 2\">\n                <img alt=\"Runway image by Ben Iwara on Unsplash\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-2-1\" data-name=\"work piece image 2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1733322991133-2de13aa12c57?auto=format&w=900&q=80&fit=crop\"/>\n                <figcaption class=\"mono mt-3 text-[10px]\" data-kid=\"3-4-2-2-2\" data-name=\"work caption 2\">\n                    02 / SOFT ARMOUR\n                </figcaption>\n            </figure>\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-3\" data-name=\"work piece card 3\">\n                <video aria-label=\"Moving fabric by Mikhail Nilov on Pexels\" autoplay=\"\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-3-1\" data-name=\"work piece video 3\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/7677257/pexels-photo-7677257.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/7677257/7677257-sd_426_240_25fps.mp4\">\n                </video>\n                <figcaption class=\"mono mt-3 text-[10px]\" data-kid=\"3-4-2-3-2\" data-name=\"work caption 3\">\n                    03 / AIR STUDY\n                </figcaption>\n            </figure>\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-4\" data-name=\"work piece card 4\">\n                <img alt=\"Concrete sculpture by Nenad Radojčić on Unsplash\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-4-1\" data-name=\"work piece image 4\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1619021420572-93869abf3482?auto=format&w=900&q=80&fit=crop\"/>\n                <figcaption class=\"mono mt-3 text-[10px]\" data-kid=\"3-4-2-4-2\" data-name=\"work caption 4\">\n                    04 / WINTER FORM\n                </figcaption>\n            </figure>\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-5\" data-name=\"work piece card 5\">\n                <img alt=\"Fashion walk by Happy Face Emoji on Unsplash\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-5-1\" data-name=\"work piece image 5\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1650057961082-d77233053b1b?auto=format&w=900&q=80&fit=crop\"/>\n                <figcaption class=\"mono mt-3 text-[10px]\" data-kid=\"3-4-2-5-2\" data-name=\"work caption 5\">\n                    05 / PROCESSION\n                </figcaption>\n            </figure>\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-6\" data-name=\"work piece card 6\">\n                <video aria-label=\"Moving fabric by Hanna Pad on Pexels\" autoplay=\"\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-6-1\" data-name=\"work piece video 6\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/7945783/abstract-animation-art-artistic-7945783.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/7945783/7945783-sd_338_640_30fps.mp4\">\n                </video>\n                <figcaption class=\"mono mt-3 text-[10px]\" data-kid=\"3-4-2-6-2\" data-name=\"work caption 6\">\n                    06 / VOLUME\n                </figcaption>\n            </figure>\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-7\" data-name=\"work piece card 7\">\n                <img alt=\"Tower image by Leon Bredella on Unsplash\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-7-1\" data-name=\"work piece image 7\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1649197912768-c31e73ef4ce6?auto=format&w=900&q=80&fit=crop\"/>\n                <figcaption class=\"mono mt-3 text-[10px]\" data-kid=\"3-4-2-7-2\" data-name=\"work caption 7\">\n                    07 / VERTIGO\n                </figcaption>\n            </figure>\n            <figure class=\"work-piece w-[440px] shrink-0\" data-kid=\"3-4-2-8\" data-name=\"work piece card 8\">\n                <img alt=\"Portrait by Reza gholami on Unsplash\" class=\"h-[440px] w-full object-cover\" data-kid=\"3-4-2-8-1\" data-name=\"work piece image 8\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1589131317479-58d848c4f07e?auto=format&w=900&q=80&fit=crop\"/>\n                <figcaption class=\"mono mt-3 text-[10px]\" data-kid=\"3-4-2-8-2\" data-name=\"work caption 8\">\n                    08 / AFTER IMAGE\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <section class=\"relative h-[80svh] min-h-[620px] bg-[#FDFFE9]\" data-kid=\"3-5\" data-name=\"portrait section\">\n        <div class=\"absolute inset-x-0 top-0 h-1/2 bg-[#111]\" data-kid=\"3-5-1\" data-name=\"portrait top dark background\">\n        </div>\n        <div class=\"hinge-image absolute inset-x-8 top-[10%] bottom-[10%] overflow-hidden\" data-kid=\"3-5-2\" data-name=\"portrait hinge image container\" id=\"hinge\">\n            <img alt=\"Black and white portrait by Ahmadreza Najafi on Unsplash\" class=\"h-full w-full object-cover grayscale\" data-kid=\"3-5-2-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1633355263308-21a7c2a604c9?auto=format&w=1920&q=80&fit=crop\"/>\n        </div>\n        <p class=\"absolute bottom-7 left-8 mono text-[10px] tracking-[.18em] text-[#111]\" data-kid=\"3-5-3\" data-name=\"portrait caption text\">\n            A STUDY IN PRESENCE / 2025\n        </p>\n    </section>\n    <section class=\"section-pad bg-[#FDFFE9] px-8 py-48 text-[#111]\" data-kid=\"3-6\" data-name=\"voices section\" id=\"voices\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"3-6-1\" data-name=\"voices section container\">\n            <p class=\"mono mb-12 text-[10px] tracking-[.18em] text-[#6B6B6B]\" data-kid=\"3-6-1-1\" data-name=\"voices section label\">\n                03 / VOICES\n            </p>\n            <article class=\"quote-row border-t border-[#111] py-10 flex justify-between\" data-kid=\"3-6-1-2\" data-name=\"voice entry 1\">\n                <p class=\"mono text-[10px] tracking-[.12em]\" data-kid=\"3-6-1-2-1\" data-name=\"voice entry number 1\">\n                    VOICE / 01\n                </p>\n                <div class=\"w-[72%]\" data-kid=\"3-6-1-2-2\" data-name=\"voice entry content 1\">\n                    <blockquote class=\"quote text-[clamp(1.8rem,3.2vw,3.4rem)] leading-[1.38]\" data-kid=\"3-6-1-2-2-1\" data-name=\"voice quote 1\">\n                        “Prerna makes an image feel like a room you can enter—and then never fully leave.”\n                    </blockquote>\n                    <p class=\"mono mt-8 text-[10px] tracking-[.1em]\" data-kid=\"3-6-1-2-2-2\" data-name=\"voice author 1\">\n                        MAYA MENON — CURATOR, OBJECTS OF GAZE\n                    </p>\n                </div>\n            </article>\n            <article class=\"quote-row border-t border-[#111] py-10 flex justify-between\" data-kid=\"3-6-1-3\" data-name=\"voice entry 2\">\n                <p class=\"mono text-[10px] tracking-[.12em]\" data-kid=\"3-6-1-3-1\" data-name=\"voice entry number 2\">\n                    VOICE / 02\n                </p>\n                <div class=\"w-[72%]\" data-kid=\"3-6-1-3-2\" data-name=\"voice entry content 2\">\n                    <blockquote class=\"quote text-[clamp(1.8rem,3.2vw,3.4rem)] leading-[1.38]\" data-kid=\"3-6-1-3-2-1\" data-name=\"voice quote 2\">\n                        “Her gaze is precise, architectural, and almost impossibly tender.”\n                    </blockquote>\n                    <p class=\"mono mt-8 text-[10px] tracking-[.1em]\" data-kid=\"3-6-1-3-2-2\" data-name=\"voice author 2\">\n                        ELENA PARK — ART DIRECTOR, RADIANT\n                    </p>\n                </div>\n            </article>\n            <article class=\"quote-row border-y border-[#111] py-10 flex justify-between\" data-kid=\"3-6-1-4\" data-name=\"voice entry 3\">\n                <p class=\"mono text-[10px] tracking-[.12em]\" data-kid=\"3-6-1-4-1\" data-name=\"voice entry number 3\">\n                    VOICE / 03\n                </p>\n                <div class=\"w-[72%]\" data-kid=\"3-6-1-4-2\" data-name=\"voice entry content 3\">\n                    <blockquote class=\"quote text-[clamp(1.8rem,3.2vw,3.4rem)] leading-[1.38]\" data-kid=\"3-6-1-4-2-1\" data-name=\"voice quote 3\">\n                        “A rare maker who holds rigor and instinct in the same frame.”\n                    </blockquote>\n                    <p class=\"mono mt-8 text-[10px] tracking-[.1em]\" data-kid=\"3-6-1-4-2-2\" data-name=\"voice author 3\">\n                        NIKHIL DAS — FOUNDER, COMMON GROUND\n                    </p>\n                </div>\n            </article>\n        </div>\n    </section>\n</main>\n<footer class=\"bg-[#FDFFE9] px-8 pb-8 pt-28 text-[#111]\" data-kid=\"4\" data-name=\"site footer\" id=\"contact\">\n    <div class=\"mx-auto max-w-[1200px]\" data-kid=\"4-1\" data-name=\"footer container\">\n        <p class=\"mono text-[10px] tracking-[.18em] text-[#6B6B6B]\" data-kid=\"4-1-1\" data-name=\"contact section label\">\n            04 / CONTACT\n        </p>\n        <h2 class=\"contact-title serif mt-4 text-[clamp(8rem,16vw,15rem)] leading-[.72] tracking-[-.06em]\" data-kid=\"4-1-2\" data-name=\"contact headline\">\n            Connect.\n        </h2>\n        <form action=\"#\" class=\"mt-24 flex max-w-[720px] border-b border-[#111] pb-4\" data-kid=\"4-1-3\" data-name=\"contact form\" onsubmit=\"return false\">\n            <label class=\"sr-only\" data-kid=\"4-1-3-1\" data-name=\"email label\" for=\"email\">\n                Your email address\n            </label>\n            <input class=\"focus-ring w-full bg-transparent text-xl outline-hidden placeholder:text-[#6B6B6B]\" data-kid=\"4-1-3-2\" data-name=\"email input field\" id=\"email\" placeholder=\"Your email address\" required=\"\" type=\"email\"/>\n            <button aria-label=\"Send email\" class=\"focus-ring ml-4 text-3xl leading-none\" data-kid=\"4-1-3-3\" data-name=\"submit button\">\n                <i class=\"ti ti-arrow-right\" data-kid=\"4-1-3-3-1\" data-name=\"arrow icon\">\n                </i>\n            </button>\n        </form>\n        <div class=\"mt-28 flex justify-between border-t border-[#111] pt-4 mono text-[10px] tracking-[.08em]\" data-kid=\"4-1-4\" data-name=\"footer copyright bar\">\n            <span data-kid=\"4-1-4-1\" data-name=\"copyright text\">\n                © 2026 MEETPRERNA\n            </span>\n            <span data-kid=\"4-1-4-2\" data-name=\"footer location text\">\n                NEW YORK / EVERYWHERE\n            </span>\n        </div>\n    </div>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);(function(){const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,pre=document.querySelector('.preloader');if(reduce){pre.remove();document.querySelectorAll('.hero-copy').forEach(e=>e.style.visibility='visible');return}const seen=sessionStorage.getItem('prerna-loaded');function init(){gsap.to('.hero-copy',{autoAlpha:1,duration:.5,stagger:.12,onStart:()=>document.querySelectorAll('.hero-copy').forEach(e=>e.style.visibility='visible')});gsap.to('#hero-media',{scale:.94,yPercent:8,ease:'none',scrollTrigger:{trigger:'#top',start:'top top',end:'bottom top',scrub:true}});gsap.to('#hero-left',{yPercent:10,ease:'none',scrollTrigger:{trigger:'#top',start:'top top',end:'bottom top',scrub:true}});gsap.to('#hero-right',{yPercent:16,ease:'none',scrollTrigger:{trigger:'#top',start:'top top',end:'bottom top',scrub:true}});ScrollTrigger.create({start:120,onEnter:()=>document.querySelector('#nav').classList.add('nav-docked'),onLeaveBack:()=>document.querySelector('#nav').classList.remove('nav-docked')});gsap.from('.stat-cell',{y:30,autoAlpha:0,duration:.8,stagger:.12,scrollTrigger:{trigger:'.stats-grid',start:'top 85%'}});gsap.fromTo('#hinge',{clipPath:'inset(0 100% 0 0)'},{clipPath:'inset(0 0% 0 0)',ease:'none',scrollTrigger:{trigger:'#hinge',start:'top 78%',end:'bottom 35%',scrub:true}});gsap.from('.quote-row',{y:24,autoAlpha:0,duration:.65,stagger:.12,scrollTrigger:{trigger:'#voices',start:'top 72%'}})}if(!seen){const line=document.querySelector('.stencil-line');gsap.to(line,{strokeDashoffset:0,duration:1.1,ease:'power2.inOut'});gsap.to(pre,{autoAlpha:0,duration:.2,delay:1.1,onComplete:()=>{pre.remove();init()}});sessionStorage.setItem('prerna-loaded','1')}else{pre.remove();init()}const rail=document.querySelector('#rail');let down=false,x,start;rail.addEventListener('pointerdown',e=>{down=true;x=e.clientX;start=rail.scrollLeft;rail.setPointerCapture(e.pointerId);rail.classList.add('dragging')});rail.addEventListener('pointermove',e=>{if(down)rail.scrollLeft=start-(e.clientX-x)});['pointerup','pointercancel'].forEach(t=>rail.addEventListener(t,()=>{down=false;rail.classList.remove('dragging')}));})();\n</script>\n",
