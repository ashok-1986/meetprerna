# Cloudflare R2 Credentials (used by scripts/upload-to-r2.mjs)
# Do not commit the actual .env.local file with secrets to Git.

R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="your_bucket_name"

# The public URL for your bucket (e.g., https://pub-xxx.r2.dev or custom domain)
NEXT_PUBLIC_IMAGE_HOST="https://your-custom-r2-domain.com"
